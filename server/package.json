{
  "name": "kurostream-server",
  "version": "2.0.0",
  "description": "KuroStream production backend server with PostgreSQL, JWT auth, rate limiting, monitoring",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:create": "tsx src/db/create-migration.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "axios": "^1.7.2",
    "google-auth-library": "^9.10.0",
    "firebase-admin": "^12.2.0",
    "pg": "^8.11.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "prom-client": "^15.1.0",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "jose": "^5.2.3"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.10.2",
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "@types/node": "^20.12.12",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}