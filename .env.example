# KuroStream Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
APP_URL=https://kuro-stream-tv.lovable.app
APP_NAME=KuroStream

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://kurostream:password@localhost:5432/kurostream
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=kurostream
JWT_AUDIENCE=kurostream-app

# =============================================================================
# FIREBASE (for FCM & App Check)
# =============================================================================
FIREBASE_PROJECT_ID=kurostream-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kurostream-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =============================================================================
# GOOGLE PLAY INTEGRITY
# =============================================================================
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
GOOGLE_CLOUD_PROJECT_ID=kurostream-app

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=604800000
DEVICE_SESSION_LIMIT=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_DIR=./logs
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key
REALDEBRID_API_KEY=your_realdebrid_api_key
TMDB_API_KEY=your_tmdb_api_key

# =============================================================================
# SECURITY
# =============================================================================
CORS_ORIGIN=https://kuro-stream-tv.lovable.app
TRUSTED_PROXIES=127.0.0.1

# =============================================================================
# ANDROID BUILD (for CI/CD)
# =============================================================================
UPLOAD_KEYSTORE_PATH=./upload-keystore.jks
UPLOAD_KEYSTORE_PASSWORD=your_keystore_password
UPLOAD_KEY_ALIAS=your_key_alias
UPLOAD_KEY_PASSWORD=your_key_password

# =============================================================================
# GOOGLE PLAY / FIREBASE (for CI/CD)
# =============================================================================
PLAY_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=kurostream-app
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
GCP_PROJECT=kurostream-app
GCP_SA_KEY={"type":"service_account","project_id":"..."}