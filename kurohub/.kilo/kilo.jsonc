{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "firebase": {
      "type": "local",
      "command": ["node", "/usr/local/lib/node_modules/firebase-mcp/dist/cli/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "oauth": {
        "scope": "account:read user:read"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "external_directory": {
      "/proc/*": "allow",
      "/etc/*": "allow",
      "/root/.tmp/*": "allow",
      "/*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "*": {
    },
    "read": {
      "*": "allow"
    }
  }
}
