{
  "name": "kurostream-sync",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/workers/sync-worker.ts",
  "durable_objects": {
    "classes": {
      "SyncRoom": "./src/workers/sync-room"
    }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }
  ],
  "kv_namespaces": [
    {
      "binding": "KURO_KV",
      "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  ],
  "d1_databases": [
    {
      "binding": "KURO_DB",
      "database_name": "kuro-stream-db",
      "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    }
  ]
}
