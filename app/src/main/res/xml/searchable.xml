<?xml version="1.0" encoding="utf-8"?>
<!--
  System search configuration.
  - Used by Android TV launcher mic button (long-press mic on the remote).
  - Used by Fire TV hands-free Alexa voice queries routed via ACTION_SEARCH.
  - Used by Gboard / SwiftKey "search this app" voice input.
  - Included in global search (appears alongside Netflix, Prime Video, etc. on Android TV home).
-->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:label="@string/app_name"
    android:description="@string/search_description"
    android:hint="@string/search_hint"
    android:searchMode="queryRewriteFromData"
    android:voiceSearchMode="showVoiceSearchButton|launchRecognizer"
    android:voiceLanguageModel="free_form"
    android:voicePromptText="@string/search_voice_prompt"
    android:includeInGlobalSearch="true"
    android:searchSuggestAuthority="com.kurostream.app.provider"
    android:searchSuggestIntentAction="android.intent.action.VIEW"
    android:searchSuggestIntentData="content://com.kurostream.app.provider/media"
    tools:ignore="MissingDefaultResource" />
